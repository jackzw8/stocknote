-- 资讯收藏（老周 2026-09-25）
--
-- 用途：个股资讯列表可**收藏**条目（⭐），并在「⭐ 收藏」分类里回看。
-- 为什么落本地表而不是 app_setting KV：收藏是**结构化列表**（要按时间倒序展示、可逐条取消），
-- 且条数会增长，单独一张表更规整（也随加密备份迁移）。
--
-- 说明：id 用腾讯资讯的条目 id（全市场唯一）；同时冗余存 symbol/title/url —— 因为收藏列表
-- 要能**离线查看**（不能依赖再去拉接口）。
CREATE TABLE news_favorite (
    id         TEXT NOT NULL PRIMARY KEY,   -- 腾讯资讯条目 id
    symbol     TEXT NOT NULL DEFAULT '',    -- 收藏时所属标的（如 hk00700 / sh600519）
    title      TEXT NOT NULL DEFAULT '',
    src        TEXT NOT NULL DEFAULT '',    -- 来源
    time_text  TEXT NOT NULL DEFAULT '',    -- 展示用时间（接口原样）
    url        TEXT NOT NULL DEFAULT '',
    kind       INTEGER NOT NULL DEFAULT 2,  -- 0 公告 / 1 研报 / 2 资讯
    created_at TEXT NOT NULL                -- 收藏时间（yyyy-MM-dd）
);

selectAll:
SELECT * FROM news_favorite ORDER BY created_at DESC, id;

selectIds:
SELECT id FROM news_favorite;

upsert:
INSERT OR REPLACE INTO news_favorite(id, symbol, title, src, time_text, url, kind, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM news_favorite WHERE id = ?;

countAll:
SELECT count(*) FROM news_favorite;
