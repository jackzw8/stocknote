# ============================================================
# StockNote 项目 .gitignore
# 入库：**仅代码工程**（StockNoteKMP/）
# 排除：项目文档/ · 构建产物 · 交付/ 与 归档/（本地留档）· 签名密钥
# ============================================================

# ---- 构建产物与缓存 ----
build/
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
captures/
.idea/
*.iml
local.properties

# ---- 二进制产物（体积大，且可由源码重建）----
*.apk
*.aab
*.zip
*.hprof
*.log

# ---- 本地留档目录（老周 2026-09-23：与 交付/ 同性质，不入库）----
# 历史交付物、被取代的文档与素材都放这里，属本地留档，不需要版本管理
归档/
交付/

# ---- 项目文档（老周 2026-09-30 最终决定：**不入库**）----
# 需求/技术说明书、界面原型、审核报告、测试用例、交接说明，以及 pack_source.py（打源码包）/
# md2docx.py（md 转 docx）两个脚本 —— 都是**本机工作资料**，两个分支都不跟踪，也不上 GitHub。
# ⚠️ 此前 develop 曾跟踪该目录，靠同步流程里的 `git rm -r --cached 项目文档` 在 main 上排除；
#    老周决定简化：**develop 也解除跟踪**，两条分支规则由此统一 ——
#    以后同步 main 不再需要那一步特殊处理（远端历史里本来就没有过该目录）。
项目文档/

# ---- 文档生成流水线的临时工作区（AI 生成的中间产物，不入库）----
output/

# ---- 签名密钥（绝不入库）----
*.jks
*.keystore
keystore.properties

# ---- AI 助手工作区（非项目文档）----
.workbuddy/
.codebuddy/

# ---- 旧库备份目录 ----
.git.bak-*/

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 临时文件（调试脚本产物）----
/_*
_swipe*/
_num/
